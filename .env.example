# Copy to .env (Prisma CLI reads .env; Next.js also reads it).
# Supabase project: https://wjufuurljgdrhayvxgqd.supabase.co
# Copy actual hosts and percent-encoded passwords from the project's Connect panel.
# Transaction pooler (port 6543) for the application / Vercel:
DATABASE_URL="postgresql://postgres.wjufuurljgdrhayvxgqd:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Session pooler (port 5432) or direct connection for migrations:
DIRECT_URL="postgresql://postgres.wjufuurljgdrhayvxgqd:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://wjufuurljgdrhayvxgqd.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
# Generate with: openssl rand -hex 32
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
