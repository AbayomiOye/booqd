{
  "name": "beauty-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test tests/*.test.cjs",
    "db:check": "node --env-file=.env scripts/check-database.cjs",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "autoprefixer": "^10",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
